#.env.template file

MYSQLDB_ROOT_PASSWORD=supersecret
MYSQLDB_DATABASE=litflix
MYSQLDB_USER=user
MYSQLDB_PASSWORD=password

MYSQLDB_LOCAL_PORT=3307
MYSQLDB_DOCKER_PORT=3306

SPRING_LOCAL_PORT=8088
SPRING_DOCKER_PORT=8080
DEBUG_PORT=5005

SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3307/litflix?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=password

SPRING_LIQUIBASE_ENABLED=true
SPRING_LIQUIBASE_CHANGELOG=classpath:db/changelog/db.changelog-master.yaml

SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect

JWT_SECRET=UnbreakableSecureKeyForAccessControl2025
JWT_EXPIRATION_MS=604800000
